# Copy to .env and edit. Values here are read by autofab/agents.py via
# python-dotenv; real environment variables always take precedence.

# --- Claude on Amazon Bedrock ------------------------------------------------
LLM_BACKEND=bedrock
AWS_REGION=us-east-1
# AWS_PROFILE=my-sso-profile      # omit to use ambient credentials
# CODER_MODEL=claude-sonnet-5     # the `anthropic.` prefix is added for you
# JUDGE_MODEL=claude-opus-5
# CODER_MAX_TOKENS=16000          # output budget for Planner/Coder/Refiners.
#                                 # Thinking tokens come out of it too, so do
#                                 # not drop it below 8192: a hard T3 entry can
#                                 # spend the lot thinking and reply with
#                                 # nothing at all.
# TRUNCATION_RETRY_CEILING=32000  # how far one retry may raise it
# EXEC_TIMEOUT=300                # seconds; raise on slow/synced filesystems

# --- First-party Claude API -------------------------------------------------
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- Local OpenAI-compatible server (e.g. Qwen via vLLM) --------------------
# LLM_BACKEND=local
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=...
# VLLM_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct
# VLLM_TIMEOUT=900
# VLLM_STREAM=1
